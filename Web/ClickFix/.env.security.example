# Copy this file to .env.security on the server and replace values.
# Paths are relative to your vhost document root (example: /var/www/clickfix.jordiserrano.me).
# Default public URL expected by extension/scripts: https://clickfix.jordiserrano.me/

CLICKFIX_API_JWT_SECRET=replace_with_random_hex_96_chars
CLICKFIX_SECRET_PEPPER=replace_with_random_hex_64_chars
CLICKFIX_USER_API_KEYS_SECRET=replace_with_random_hex_64_chars
CLICKFIX_HIDE_API_UI=1
CLICKFIX_PROVIDER_VIRUSTOTAL_API_KEY=
CLICKFIX_PROVIDER_ABUSEIPDB_API_KEY=
CLICKFIX_PROVIDER_URLSCAN_API_KEY=
CLICKFIX_PROVIDER_THREATRIP_API_KEY=
CLICKFIX_PROVIDER_THREATRIP_BASE_URL=https://www.threat.rip
CLICKFIX_PROVIDER_THREATRIP_AUTH_HEADER=Authorization
CLICKFIX_PROVIDER_THREATRIP_AUTH_PREFIX=
CLICKFIX_API_LICENSE_KEYS=LIC-XXXXXX-XXXXXX-XXXXXX-XXXXXX:premium:600
CLICKFIX_REPORT_REQUIRE_AUTH=1
CLICKFIX_ALLOWED_ORIGINS=https://clickfix.jordiserrano.me
CLICKFIX_SIGN_PRIVATE_KEY=keys/clickfix_sign_private.pem
CLICKFIX_SIGN_KEY_ID=k20260301
CLICKFIX_PREMIUM_SCORE_CONFIG_PATH=clickfix-score-config-premium.json
CLICKFIX_SITESHOT_API_KEY=
CLICKFIX_ENABLE_CORRELATION_FETCH=0

# Monetization (optional)
# Privacy hard-stop (recommended): disables external tracking/ads/donation widgets.
CLICKFIX_DISABLE_EXTERNAL_TRACKING=1
# Set CLICKFIX_MONETIZATION_ENABLED=1 to enable support widgets.
CLICKFIX_MONETIZATION_ENABLED=0
CLICKFIX_DONATION_PAYPAL_URL=
CLICKFIX_DONATION_KOFI_URL=
CLICKFIX_DONATION_STRIPE_URL=
# Google AdSense (optional)
CLICKFIX_ADSENSE_ENABLED=0
CLICKFIX_ADSENSE_CLIENT=
CLICKFIX_ADSENSE_SLOT=

# About / contact profile (optional, shown in dashboard "Acerca de")
CLICKFIX_OWNER_NAME=Jordi Serrano
CLICKFIX_CONTACT_EMAIL=security@jordiserrano.me
CLICKFIX_CONTACT_WEBSITE=https://jordiserrano.me
CLICKFIX_CONTACT_LINKEDIN=
CLICKFIX_CONTACT_X=
CLICKFIX_CONTACT_GITHUB=

# WhatWeb enrichment (optional, Linux server)
# Only hostname/subdomain is scanned (no path/query execution).
# CLICKFIX_WHATWEB_BIN defaults to "whatweb".
CLICKFIX_WHATWEB_BIN=whatweb
CLICKFIX_WHATWEB_TIMEOUT_SECONDS=12
CLICKFIX_WHATWEB_AGGRESSION=1
# Optional override if DB lives outside default paths:
# CLICKFIX_DB_PATH=/var/www/clickfix.jordiserrano.me/data/clickfix.sqlite
